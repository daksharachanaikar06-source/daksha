# ===================== REQUIRED =====================
# Neon Postgres connection string (get from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Generate a long random string (e.g. openssl rand -base64 32)
AUTH_SECRET=your-long-random-secret-here

# Public URL of your deployed app (used in emails and QR links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================== EMAIL (Resend) =====================
# Get from resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Franchise & Investment Summit

# ===================== OPTIONAL =====================
# Used by Vercel Cron for scheduled reminders
CRON_SECRET=another-long-random-secret

# Image storage (add later when needed)
# IMAGE_STORAGE_PROVIDER=
# IMAGE_STORAGE_API_KEY=
# IMAGE_STORAGE_BASE_URL=
